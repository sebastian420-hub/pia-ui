# Copy to .env.local (gitignored). Vite exposes only VITE_* variables to the browser.
VITE_API_URL=http://localhost:8001
# Sign in with a per-user token on the sign-in screen (an admin mints it); nothing is built in
# Optional: Cesium ion token for default imagery/terrain (https://ion.cesium.com/tokens).
# Leave empty to use token-free OpenStreetMap imagery.
VITE_CESIUM_ION_TOKEN=
